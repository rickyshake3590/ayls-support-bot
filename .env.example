# Summit Translate — environment template
# Copy to `.env` for local dev. In Cloud Run these come from Secret Manager (§4),
# NOT from a committed file. Never hardcode real values (§12).
# The static frontend draft uses none of these yet — this is the contract for the
# FastAPI backend when it lands.

# --- Anthropic (translation, Claude Haiku only — §10) ---
ANTHROPIC_API_KEY=sk-ant-placeholder
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google Cloud (STT/TTS + hosting — §4) ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-southeast1
# Local dev only: path to a service-account key. In Cloud Run use the runtime
# service account via native IAM instead — do NOT ship a key file.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
# TTS: Standard or WaveNet only, to stay in the free tier (§10) — no Studio/Chirp 3 HD
TTS_VOICE_TIER=WaveNet

# --- App behaviour ---
# Shared event passphrase (§5). Validated server-side — the value in the frontend
# draft is demo-only and must not be the real gate.
APP_PASSPHRASE=change-me-before-launch
# Live session auto-disconnect, minutes (§10) — bounds STT/TTS spend
LIVE_SESSION_MINUTES=12
