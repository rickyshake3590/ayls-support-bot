# Summit Translate — config contract (placeholders only; never commit real values)
#
# Local dev:  copy this file to  backend/.env  and fill in real values.
#             main.py loads backend/.env automatically via python-dotenv.
# Cloud Run:  do NOT ship a .env. The secrets below come from Secret Manager
#             (ids: anthropic-api-key, app-passphrase, app-signing-secret); the
#             plain settings below are set as normal env vars on the service.

# ── Secrets (Secret Manager in prod / .env locally) ──────────────────────────
ANTHROPIC_API_KEY=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
APP_PASSPHRASE=summit2026
# Long random string used to sign session tokens. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SIGNING_SECRET=AkoHl3lMWUQGNQK2Pudl6HdfIK7FVYuKrAESNpBCvT9YJNAoiDr4Lpt481ckGpCZ

# ── Non-secret runtime settings (plain env vars) ─────────────────────────────
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # Haiku only (§10) — do not switch to Sonnet
LIVE_SESSION_MINUTES=12                      # live auto-disconnect cap (§10)
ALLOWED_ORIGIN=*                             # set to your domain in prod for CORS
# How often (ms) a partial sentence is translated during live "as you speak".
# Lower = snappier + more API calls; higher = cheaper + slight lag; very high =
# only translate finished sentences. Tune against the $200 cap (§10).
LIVE_PARTIAL_INTERVAL_MS=900

# ── Google Cloud (STT/TTS + Secret Manager) ──────────────────────────────────
GCP_PROJECT_ID=ai-translation-app-502506
# Local dev only: path to a service-account key with Speech + TTS access.
# On Cloud Run this is unset — native IAM service-account creds are used instead.
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# TTS voice overrides — Standard/WaveNet ONLY to stay in the free tier (§10).
# Never point these at Studio or Chirp-3-HD voices.
TTS_VOICE_EN=en-US-Standard-C
TTS_VOICE_TH=th-TH-Standard-A
